# Copy to .env and fill in your secrets.
# NEVER commit .env to version control — it is in .gitignore.

# Required: OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Reddit credentials (required for posting/commenting)
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Ollama base URL (only needed if provider: ollama in config.yaml)
# OLLAMA_BASE_URL=http://localhost:11434

# Geo proxy (optional — for routing traffic through a specific region)
# PROXY_URL=http://host:port
# PROXY_USERNAME=
# PROXY_PASSWORD=

# Log level: DEBUG | INFO | WARNING | ERROR (default: WARNING)
# LOG_LEVEL=INFO

# ──────────────────────────────────────────────
# Web API settings (serve.py / src/api/)
# ──────────────────────────────────────────────

# Comma-separated API keys for the chat API.
# Leave empty to disable authentication (dev-only — NEVER empty in production).
# Example: API_KEYS=key-abc123,key-def456
API_KEYS=

# Comma-separated list of allowed CORS origins.
# Use explicit origins in production; "*" allows all (dev-only).
# Example: CORS_ORIGINS=https://yoursite.com,https://www.yoursite.com
CORS_ORIGINS=*

# Max requests per minute per IP address (default: 30).
# RATE_LIMIT_RPM=30

# Session idle timeout in seconds (default: 1800 = 30 minutes).
# SESSION_TTL_SECONDS=1800

# Maximum concurrent chat sessions (default: 1000).
# MAX_SESSIONS=1000

# Disable /docs and /redoc Swagger UI in production (set to 1).
# DOCS_DISABLED=0
