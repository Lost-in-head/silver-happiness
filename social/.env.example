# Copy to .env and fill in your secrets.
# NEVER commit .env to version control — it is in .gitignore.

# Required: OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Reddit credentials (required for posting/commenting)
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Ollama base URL (only needed if provider: ollama in config.yaml)
# OLLAMA_BASE_URL=http://localhost:11434

# Geo proxy (optional — for routing traffic through a specific region)
# PROXY_URL=http://host:port
# PROXY_USERNAME=
# PROXY_PASSWORD=

# Log level: DEBUG | INFO | WARNING | ERROR (default: WARNING)
# LOG_LEVEL=INFO
