# Copy to .env and fill in your secrets.
# Do NOT commit .env to version control.

# Required: OpenAI API key for LLM and embeddings
OPENAI_API_KEY=sk-...

# Reddit credentials (optional: for automated posting/commenting)
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Proxy for geolocation (optional)
# Format: http://host:port  (credentials below or inline in URL if simple)
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
